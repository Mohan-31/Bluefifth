# ============================================================
# BLUEFIFTH — Environment Variables Template
#
# Copy this file to .env and fill in your real values.
# .env is gitignored — NEVER commit it with real credentials.
# ============================================================

# ── Application ──────────────────────────────────────────────
# Local XAMPP:   BASE_URL=http://localhost/ecommerce-project  BASE_PATH=/ecommerce-project
# Production:    BASE_URL=https://bluefifth.in                BASE_PATH=
BASE_URL=http://localhost/ecommerce-project
BASE_PATH=/ecommerce-project
SITE_NAME=Bluefifth
APP_ENV=development

# ── Database (Neon PostgreSQL) ────────────────────────────────
# Option A — Neon connection string (recommended for Vercel).
# Copy this from: neon.tech → your project → Connection Details → .env
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/neondb?sslmode=require

# Option B — individual vars (used only if DATABASE_URL is not set)
DB_HOST=ep-xxx-xxx.region.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=require

# ── Admin ────────────────────────────────────────────────────
ADMIN_EMAIL=your@email.com

# ── Brevo / Sendinblue Email ─────────────────────────────────
SENDINBLUE_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDINBLUE_FROM_EMAIL=info@yourdomain.com
SENDINBLUE_FROM_NAME=Bluefifth

# ── Shiprocket Webhook Tokens ─────────────────────────────────
# Must match what you register in the Shiprocket dashboard.
SHIPROCKET_ORDER_WEBHOOK_TOKEN=change_this_to_a_strong_secret
SHIPROCKET_RETURN_WEBHOOK_TOKEN=change_this_to_a_strong_secret

# ── Razorpay ─────────────────────────────────────────────────
# Keys are stored in DB via Admin Panel → Settings → Payment.
# Test:  rzp_test_xxxxxxxxxxxxxxxxxxxx
# Live:  rzp_live_xxxxxxxxxxxxxxxxxxxx

# ── Shiprocket Login ─────────────────────────────────────────
# Set via Admin Panel → Settings → Shipping (stored in DB, not read from env)

# ── Fast2SMS (Phone OTP) ──────────────────────────────────────
# Sign up at fast2sms.com → Dev API → Copy your API key
# Leave blank or set to dev for local testing (OTP will be logged to Apache error log)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# ── Google OAuth ──────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorised JavaScript origins:  http://localhost, https://bluefifth.in
# Authorised redirect URIs:        http://localhost/ecommerce-project/auth/google-callback.php
GOOGLE_CLIENT_ID=340757900430-i8nl6l45ndveq9jmbvbah7ugquauj803.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
